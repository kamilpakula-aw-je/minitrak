{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:leads": "LEADS_TEST_PORT=23787 node --test tests/leads-preview.test.mjs",
    "test:intake": "LEAD_INTAKE_TEST_PORT=23789 node --test tests/lead-intake.test.mjs",
    "test:retry": "node ./build.mjs && node --test tests/lead-retry.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^11.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "pg": "^8.20.0"
  }
}
